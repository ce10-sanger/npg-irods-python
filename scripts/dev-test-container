#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

mkdir -p coverage

docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d \
    mysql-server irods-server app-dev

exec docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T \
    app-dev pytest --it "$@"
